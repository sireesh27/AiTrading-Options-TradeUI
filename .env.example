# TastyTrade Configuration
# OAuth2 (Recommended - Required after Dec 1, 2025)
TASTY_CLIENT_SECRET=your_client_secret_here
TASTY_REFRESH_TOKEN=your_refresh_token_here
TASTY_LIVE=True

# Legacy authentication (deprecated)
# TASTY_USERNAME=your_email@example.com
# TASTY_PASSWORD=your_password

# Alpaca Configuration - Live Account
ALPACA_API_KEY=your_live_api_key_here
ALPACA_API_SECRET=your_live_api_secret_here
ALPACA_PAPER=false  # false for live account

# Alpaca Configuration - Paper Account
ALPACA_PAPER_API_KEY=your_paper_api_key_here
ALPACA_PAPER_API_SECRET=your_paper_api_secret_here
ALPACA_PAPER_PAPER=true  # true for paper account

# IBKR Configuration
# The code now supports BOTH Live and Paper accounts simultaneously!
# Local IBKR ports (TWS/IB Gateway on same machine):
#   - Port 7496 = Live Trading Account
#   - Port 7497 = Paper Trading Account
# No configuration needed - ports are automatically assigned based on account type

# For cloud IBKR (Docker/VPS/EC2) - Optional
# IBKR_HOST=your-server-ip-or-hostname
# IBKR_LIVE_PORT=4002    # Cloud port for live trading
# IBKR_PAPER_PORT=4001   # Cloud port for paper trading

# IBKR Docker Configuration (for docker-compose) - Optional
# IBKR_USERNAME=your_ibkr_username
# IBKR_PASSWORD=your_ibkr_password
# Paper needs its OWN paper user (IB rejects the live login for paper when
# multiple paper users exist). Client Portal -> Settings -> Paper Trading Account
# IBKR_PAPER_USERNAME=your_paper_username
# IBKR_PAPER_PASSWORD=your_paper_password
# IBKR_TRADING_MODE=paper  # 'paper' or 'live'
# VNC_PASSWORD=changeme123  # For VNC access (optional)

# ─────────────────────────────────────────────────────────────────────────────
# IBKR Web API (headless OAuth 1.0a) — no Gateway / TWS / VM required
# ─────────────────────────────────────────────────────────────────────────────
# Set IBKR_API_MODE=webapi to use IBKR's REST Web API instead of the TWS socket
# API. IBKR hosts the brokerage session, so trading runs fully unattended once
# these credentials (generated in IBKR's OAuth self-service portal) are set.
# See IBKR_WEBAPI_SETUP.md for the step-by-step credential generation guide.
#
# IBKR_API_MODE=webapi     # 'tws' (default) or 'webapi'
#
# ── Paper account credentials ──
# IBKR_WEBAPI_PAPER_CONSUMER_KEY=your_paper_consumer_key
# IBKR_WEBAPI_PAPER_ACCESS_TOKEN=your_paper_access_token
# IBKR_WEBAPI_PAPER_ACCESS_TOKEN_SECRET=your_paper_access_token_secret
# IBKR_WEBAPI_PAPER_DH_PRIME=hex_prime_from_dhparam_pem
# IBKR_WEBAPI_PAPER_ENCRYPTION_KEY_FP=./secrets/paper_private_encryption.pem
# IBKR_WEBAPI_PAPER_SIGNATURE_KEY_FP=./secrets/paper_private_signature.pem
# IBKR_WEBAPI_PAPER_DH_GENERATOR=2
# IBKR_WEBAPI_PAPER_REALM=limited_poa
# IBKR_WEBAPI_PAPER_ACCOUNT_ID=your_paper_account_id   # optional; auto-resolved
#
# ── Live account credentials (separate OAuth registration) ──
# IBKR_WEBAPI_LIVE_CONSUMER_KEY=your_live_consumer_key
# IBKR_WEBAPI_LIVE_ACCESS_TOKEN=your_live_access_token
# IBKR_WEBAPI_LIVE_ACCESS_TOKEN_SECRET=your_live_access_token_secret
# IBKR_WEBAPI_LIVE_DH_PRIME=hex_prime_from_dhparam_pem
# IBKR_WEBAPI_LIVE_ENCRYPTION_KEY_FP=./secrets/live_private_encryption.pem
# IBKR_WEBAPI_LIVE_SIGNATURE_KEY_FP=./secrets/live_private_signature.pem
# IBKR_WEBAPI_LIVE_DH_GENERATOR=2
# IBKR_WEBAPI_LIVE_REALM=limited_poa
# IBKR_WEBAPI_LIVE_ACCOUNT_ID=your_live_account_id     # optional; auto-resolved

# Massive API Configuration (for Option Greeks and Market Data)
MASSIVE_API_KEY=eSWJeT5TWKxadoMbBovHIokGkCABRhH1
